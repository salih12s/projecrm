    PORT=5000

# --- Veritabanı (lokal/dev için ayrı parametreler) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- Veritabanı (production / Railway için tek URL) ---
# Railway DATABASE_URL'i set ederse aşağıdaki kullanılır ve SSL açılır.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB

# --- Auth ---
JWT_SECRET=your_jwt_secret_key_change_in_production
SYSTEM_PASSWORD_HASH=your_system_password_hash_here

# --- Ortam / CORS ---
NODE_ENV=development
# CORS allowed origin (virgülle ayırarak birden fazla verilebilir; opsiyonel)
# FRONTEND_URL=http://localhost:5173

# Sistem şifresi hash'ini oluşturmak için:
# cd backend
# npx ts-node src/generateSystemPasswordHash.ts

