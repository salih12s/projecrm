{
  "name": "projecrm",
  "version": "1.0.0",
  "description": "Teknik servis, atölye ve saha operasyonları için gerçek zamanlı CRM platformu.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "npx tsc -p backend/tsconfig.json && cd frontend && npm ci && npm run build",
    "clean": "cd backend && rmdir /s /q node_modules dist 2>nul & cd ../frontend && rmdir /s /q node_modules dist 2>nul & rmdir /s /q node_modules 2>nul",
    "test:api": "powershell -ExecutionPolicy Bypass -File ./test-api.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,html}\""
  },
  "keywords": [
    "crm",
    "typescript",
    "react",
    "nodejs",
    "postgresql",
    "material-ui",
    "socket.io",
    "real-time"
  ],
  "author": "Salih Saydam",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salih12s/projecrm.git"
  },
  "bugs": {
    "url": "https://github.com/salih12s/projecrm/issues"
  },
  "homepage": "https://github.com/salih12s/projecrm#readme",
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^5.14.18",
    "@mui/material": "^5.14.18",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "socket.io": "^4.6.2",
    "socket.io-client": "^4.6.2",
    "typescript": "^5.3.2",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4"
  }
}
